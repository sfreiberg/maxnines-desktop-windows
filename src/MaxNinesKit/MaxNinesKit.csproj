<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that talks to the server or decides what to show, with nothing
       from Windows, so it can be tested anywhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MaxNinesKit.Tests" />
  </ItemGroup>

</Project>
